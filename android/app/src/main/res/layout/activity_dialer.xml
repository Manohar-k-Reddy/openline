<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- Header: what this phone is and whether it is online -->
        <TextView
            style="@style/Gw.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OpenLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/connectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/connectionText"
                style="@style/Gw.Muted"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Setup: a real sequence, so the steps are numbered -->
        <LinearLayout
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set up this phone" />

            <include
                android:id="@+id/stepRole"
                layout="@layout/item_setup_step" />

            <include
                android:id="@+id/stepServer"
                layout="@layout/item_setup_step" />

            <include
                android:id="@+id/stepAudio"
                layout="@layout/item_setup_step" />

            <include
                android:id="@+id/stepBattery"
                layout="@layout/item_setup_step" />
        </LinearLayout>

        <!-- Dial -->
        <LinearLayout
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/Gw.Heading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call from this phone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/numberInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/dial_underline"
                    android:hint="Number"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/hint"
                    android:textFontWeight="600"
                    android:textSize="30sp" />

                <Button
                    android:id="@+id/callButton"
                    style="@style/Gw.Button.Solid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="4dp"
                    android:text="Call" />
            </LinearLayout>
        </LinearLayout>

        <!-- Advanced: manual connection, rarely needed after QR pairing -->
        <TextView
            android:id="@+id/advancedToggle"
            style="@style/Gw.Muted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="Show advanced settings"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/advanced"
            style="@style/Gw.Panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server address" />

            <EditText
                android:id="@+id/wsUrlInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:hint="wss://gateway.example.com/v1/device-channel"
                android:importantForAutofill="no"
                android:inputType="textUri" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Phone ID" />

            <EditText
                android:id="@+id/deviceIdInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="text" />

            <TextView
                style="@style/Gw.Muted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Phone token" />

            <EditText
                android:id="@+id/deviceTokenInput"
                style="@style/Gw.Field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:importantForAutofill="no"
                android:inputType="textPassword" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveConfigButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save and reconnect" />

                <Button
                    android:id="@+id/restartAudioButton"
                    style="@style/Gw.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Restart audio" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
