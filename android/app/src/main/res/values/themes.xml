<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HttpGateway" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:colorControlActivated">@color/ink</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>

    <!-- Dialogs follow the app palette (values-night swaps it), so text stays readable in dark mode. -->
    <style name="Gw.Dialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">@font/public_sans</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorAlertDialogListItem">@color/ink</item>
        <item name="android:colorAccent">@color/ink</item>
        <item name="android:buttonBarButtonStyle">@style/Gw.DialogButton</item>
    </style>

    <style name="Gw.DialogButton" parent="android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Gw" />
    <style name="Gw.Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="Gw.Heading">
        <item name="android:textSize">16sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Gw.Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="Gw.Muted">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>
    <style name="Gw.Panel">
        <item name="android:background">@drawable/bg_panel</item>
        <item name="android:padding">18dp</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="Gw.Button" parent="android:Widget.Material.Button.Borderless">
        <item name="android:background">@drawable/btn_outline</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="Gw.Button.Solid">
        <item name="android:background">@drawable/btn_solid</item>
        <item name="android:textColor">@color/on_ink</item>
    </style>
    <style name="Gw.Button.End">
        <item name="android:background">@drawable/btn_end</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="Gw.Field">
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">12dp</item>
        <item name="android:minHeight">44dp</item>
    </style>
</resources>
