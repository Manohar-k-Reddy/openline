PORT=8787
HOST=0.0.0.0
# Long random secret for the API and the admin console. Required.
HTTP_GATEWAY_API_KEY=change-me

# Public https address phones use (Tailscale Funnel or Cloudflare Tunnel URL).
PUBLIC_URL=https://your-machine.your-tailnet.ts.net

# Root API key; also the one-time setup key for the console password. Everything below is
# optional and can be set (and overridden) in the console's Settings page instead.

# Optional: AI phone assistant (Gemini Live).
# GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-3.8-live
AGENT_OWNER_NAME=Your Name

# Folder of the SQLite database (gateway.db) holding all phones, calls, messages and settings.
DATA_DIR=data

# Optional: where the console's Docs link points.
# DOCS_URL=https://docs.example.com

# Optional default webhook destination for all call events.
# WEBHOOK_URL=https://example.com/http-gateway/events
